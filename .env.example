# ===== 動作モード =====
# true にすると外部 API 5 本すべてをモックに差し替える（開発・テスト用）
MOCK_EXTERNAL_API=true
LOG_LEVEL=info
CLASSIFY_BATCH_SIZE=10
NOTIFY_BATCH_SIZE=10

# ===== Gmail（README「Gmail API の準備」参照）=====
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=in:inbox -category:promotions -category:social

# ===== Discord（README「Discord Bot の準備」参照）=====
DISCORD_BOT_TOKEN=
DISCORD_INQUIRY_CHANNEL_ID=
DISCORD_URGENT_CHANNEL_ID=
DISCORD_SALES_MANAGER_USER_ID=
DISCORD_SALES_ROLE_ID=

# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_DAILY_LIMIT=300

# ===== Slack Incoming Webhook（チャンネルごとに 1 本）=====
SLACK_WEBHOOK_RENTAL=
SLACK_WEBHOOK_SALES=
SLACK_WEBHOOK_VIEWING=
SLACK_WEBHOOK_COMPLAINT=
SLACK_WEBHOOK_UNSORTED=

# ===== Supabase（Settings > API）=====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
